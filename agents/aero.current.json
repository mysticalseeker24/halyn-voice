                "type": "object",
                "required": ["action", "params", "readback_confirmed", "caller_quotes"],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "One of: card.freeze, card.reset_pin, fee.waive, transfer.saved, transfer.new_payee, emi.move_date, statement.view, balance.view, dispute.charge, upi.raise_limit, loan.new, profile.change_mobile, profile.change_email, account.add_owner, account.close, wire.international."
                  },
                  "params": {
                    "type": "string",
                    "description": "The details as key=value pairs separated by semicolons. No quotes, no braces, no JSON. Amounts are amount_minor = rupees x 100 (45000 rupees -> 4500000) with currency INR. Keys per action: card.freeze/card.reset_pin card_last4; fee.waive amount_minor, currency, fee_id; transfer.saved amount_minor, currency, payee_id; transfer.new_payee amount_minor, currency, payee_account_last4, payee_ifsc, payee_name (optional); emi.move_date loan_id, new_day 1-28; statement.view/balance.view/account.close account (savings or current); dispute.charge card_last4, amount_minor, currency, merchant; upi.raise_limit amount_minor, currency; loan.new amount_minor, currency, tenure_months; profile.change_mobile new_number with +91; profile.change_email new_email; account.add_owner account, owner_name; wire.international amount_minor, currency, payee_account_last4, swift_bic, payee_country. Examples: card_last4=8812 or amount_minor=4500000; currency=INR; payee_account_last4=4471; payee_ifsc=AERO0000001"
                  },
                  "call_sid": {
                    "type": "string",
                    "description": "Telephony call id. Filled automatically."
                  },
                  "from_number": {
                    "type": "string",
                    "description": "Calling number. Filled automatically."
                  },
                  "caller_quotes": {
                    "type": "string",
                    "description": "The caller's last one or two sentences, word for word, without any double quotes. Separate sentences with ' | '."
                  },
                  "readback_confirmed": {
                    "type": "string",
                    "description": "true only if the caller clearly said yes to the read-back, otherwise false."
                  }
                }
              },
              "description": "Submit the caller's request for a security decision. Use it only on the propose step. The decision arrives a moment later.",
              "pre_call_message": "जी।"
