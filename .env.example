# Copy to .env (and to apps/*/.dev.vars for wrangler dev). Never commit real values.
# Production secrets: `wrangler secret put <NAME>` (api, aero-core) and Vercel env vars (web).

# Bolna
BOLNA_API_KEY=
BOLNA_AERO_AGENT_ID=
BOLNA_AERO_EN_AGENT_ID=
BOLNA_CONFIRM_AGENT_ID=
BOLNA_ASSISTANT_AGENT_ID=
BOLNA_SOURCE_IPS=13.203.39.153,13.126.9.249,13.202.133.53
HALYN_TOOL_SECRET=            # random 32+ chars; set as a header on every Bolna custom function

# Numbers (E.164)
NUMBER_A=+918065356344
NUMBER_B=+918065356379
CUSTOMER_PHONE=               # Saksham's real phone — env only, never in code, fixtures or docs
SPECIALIST_NUMBER=            # second phone that receives warm transfers

# Halyn signing (Ed25519). Generate with: pnpm keys:generate
HALYN_SIGNING_KEY=            # private JWK (JSON string)
HALYN_PUBLIC_JWKS=            # public JWKS (JSON string) — also given to aero-core
HALYN_KEY_ID=halyn-2026-10
PASS_CODE_PEPPER=             # random 32+ chars

# Data
TIDB_DATABASE_URL=            # TiDB Cloud Starter HTTP/serverless connection URL (dev branch for local)
# D1, KV, R2 and the Hub Durable Object are bindings in apps/*/wrangler.toml

# Sarvam
SARVAM_API_KEY=

# Web
WEB_ORIGIN=http://localhost:3000
RP_ID=localhost               # passkey relying-party id = the deployed web domain in prod
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
SESSION_SECRET=
